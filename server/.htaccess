# /bank/ picks the phone app or the accounting panel; inside app/ and acc/ their own index.html
DirectoryIndex index.html app/index.html

# Only the API and the app are reachable from the web.
<FilesMatch "^(lib|bot|jobs|webpush|cron|config|config\.sample|router|setup|acc_[a-z_]+|assistant)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(sqlite|db)$">
  Require all denied
</FilesMatch>
