# Settings of the local voice service (read by bank-voice.service).
# install.sh copies this to voice.env; edit it, then: sudo systemctl restart bank-voice

# Only this server: never change to 0.0.0.0.
VOICE_HOST=127.0.0.1
VOICE_PORT=8765
# Shared secret with PHP (config.php 'voice_token'). install.sh fills it in.
VOICE_TOKEN=

VOICE_MODELS_DIR=/opt/bank-voice/models

# --- Speech to text (faster-whisper) ---
# large-v3-turbo : best choice for Persian on a CPU VPS (~1.6 GB disk, ~2 GB RAM)
# large-v3       : a bit more accurate, ~3x slower (~3 GB disk, ~4 GB RAM)
# medium / small : for small VPS (2 GB RAM), noticeably weaker Persian
STT_MODEL=large-v3-turbo
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
# 0 = all cores
STT_THREADS=0
STT_BEAM_SIZE=5

# --- Text to speech (Piper) ---
# Persian voices: fa_IR-gyro-medium (default), fa_IR-amir-medium,
# fa_IR-ganji-medium, fa_IR-ganji_adabi-medium, fa_IR-reza_ibrahim-medium
TTS_VOICE=fa_IR-gyro-medium
# >1 slower speech, <1 faster
TTS_LENGTH_SCALE=1.0

# Load both models at start (first answer is then fast)
VOICE_PRELOAD=1
